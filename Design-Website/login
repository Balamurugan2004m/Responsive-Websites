import { useEffect, useState, useCallback, useRef } from "react";
import {
  Box,
  Button,
  Typography,
  CircularProgress,
  Link as MuiLink,
  FormControlLabel,
  Checkbox,
  useTheme,
} from "@mui/material";
import CommonToast from "../../ui/common-toast";
import { useDispatch, useSelector } from "react-redux";
import { Dispatch } from "@reduxjs/toolkit";
import { RootState } from "../../store";
import { useLocation, useNavigate } from "react-router";
import { paths } from "../../constants/paths";
import PublicLayout from "../../layouts/public-layout/public-layout";
import TextInput from "../../ui/text-input";
import { useForm, Controller } from "react-hook-form";
import * as yup from "yup";
import { yupResolver } from "@hookform/resolvers/yup";
import { loginUser } from "../../services/auth";
import { updateAuthUserData, logout } from "../../store/slice/auth-slice";
import { LoginResponse } from "../../services/interfaces";
import { clearAllCaseDetailsCache } from "../case-search/case-details/case-cache";
import { resetTabs } from "../../store/slice/tabs-slice";
import AlertBanner from "../../ui/alert-banner";
import { THEME_PRIMITIVES } from "../../theme";
import warningIcon from "../../assets/warning-icon.svg";
import { AuthStatus } from "../../constants/auth-status";
import AuthCard, {
  AuthCardHeader,
  AuthCardBody,
  AuthCardFooter,
} from "../../components/auth/auth-card";
import { hasAcceptedNotice, setNoticeAcceptedCookie } from "../../utils/cookie";
import { JWTValidator } from "../../utils/jwt-validator";
import { isVeteranPortalUser } from "../../utils/user-identity";
import NoticeModal from "../../ui/notice-modal";

const loginSchema = yup.object({
  username: yup.string().required("*Required field"),
  password: yup.string().required("*Required field"),
  termsAccepted: yup
    .boolean()
    .oneOf([true], "You must accept the terms and conditions")
    .required(),
});

type LoginFormInputs = yup.InferType<typeof loginSchema>;

const Login: React.FC = () => {
  const theme = useTheme();
  const P = THEME_PRIMITIVES;
  const blackColor = theme.custom?.colors.blackColorCode ?? P.black;
  const navigate = useNavigate();
  const location = useLocation();
  const dispatch = useDispatch<Dispatch>();
  const authUserState = useSelector((state: RootState) => state.authUser);
  const { authUser } = authUserState;
  const rehydrated =
    Boolean(authUser?.Token) ||
    (authUserState as { _persist?: { rehydrated?: boolean } })._persist
      ?.rehydrated === true;
  const [isAccountDisabled, setIsAccountDisabled] = useState(false);
  const [toastType, setToastType] = useState<"passwordCreated" | "passwordReset" | "passwordExpired" | null>(null);
  const [showNoticeModal, setShowNoticeModal] = useState(!hasAcceptedNotice());
  const justLoggedIn = useRef(false);
  const {
    control,
    handleSubmit,
    formState: { errors },
    trigger,
    getValues,
    setFocus,
    clearErrors,
    setValue,
    watch,
  } = useForm<LoginFormInputs>({
    resolver: yupResolver(loginSchema),
    mode: "onSubmit",
    reValidateMode: "onSubmit",
    defaultValues: {
      username: "",
      password: "",
      termsAccepted: hasAcceptedNotice(),
    },
  });

  const [noticeAccepted, setNoticeAccepted] = useState(hasAcceptedNotice());
  const [loading, setLoading] = useState(false);
  const [authError, setAuthError] = useState<string | null>(null);
  const [incorrectUsername, setIncorrectUsername] = useState(false);
  const [sessionTimeoutMessage, setSessionTimeoutMessage] = useState<string | null>(null);
  const usernameValue = watch("username");
  const passwordValue = watch("password");
 
  const validationBanner =
  errors.username && errors.password
    ? "Please enter your username and password."
    : errors.username
    ? "Please enter your username."
    : errors.password
    ? "Please enter your password."
    : authError;
 
    const hasAuthError = authError === "Invalid username or password. Please try again!";
 
  useEffect(() => {
    if (incorrectUsername) {
      setIncorrectUsername(false);
    }
  }, [usernameValue, passwordValue]);
 
  useEffect(() => {
    if (usernameValue || passwordValue) {
      clearErrors(["username", "password"]);
      setAuthError(null);
      setSessionTimeoutMessage(null);
      setIsAccountDisabled(false);
    }
  }, [usernameValue, passwordValue, clearErrors]);
 
  useEffect(() => {
    if (!rehydrated) {
      return;
    }

    const sessionExpiredFromState = location.state?.sessionExpired === true;
    const sessionExpiredFromStorage =
      sessionStorage.getItem("sessionExpired") === "true";
    const manualLogout = sessionStorage.getItem("manualLogout") === "true";
    const sessionTimedOut = sessionExpiredFromState || sessionExpiredFromStorage;

    if (sessionTimedOut || manualLogout) {
      clearAllCaseDetailsCache();
      dispatch(resetTabs());
      dispatch(logout());
    }

    if (sessionTimedOut && !manualLogout) {
      setSessionTimeoutMessage(
        "Your session has expired and you have been logged out for security reasons, application session will be automatically logged out after 15 minutes of inactivity."
      );
    }

    sessionStorage.removeItem("sessionExpired");
    sessionStorage.removeItem("manualLogout");

    if (sessionExpiredFromState) {
      navigate(location.pathname, { replace: true, state: {} });
    }
  }, [rehydrated, dispatch, location.pathname, location.state?.sessionExpired, navigate]);

  useEffect(() => {
  if (location.state?.passwordCreated) {
    setToastType("passwordCreated");
  } else if (location.state?.passwordReset) {
    setToastType("passwordReset");
  } else if (location.state?.passwordExpired) {
    setToastType("passwordExpired");
  }

  if (location.state?.passwordCreated || location.state?.passwordReset || location.state?.passwordExpired) {
    navigate(location.pathname, {
      replace: true,
      state: {},
    });
  }
}, [location, navigate]);

  const onSubmit = useCallback(
    async (data: LoginFormInputs) => {
      setAuthError(null);
      setSessionTimeoutMessage(null);
      setIncorrectUsername(false);
      setLoading(true);
 
      try {
        const apiResponse: LoginResponse = await loginUser(
          data.username,
          data.password
        );

        if (apiResponse?.Authenticated === false) {
          switch (apiResponse?.Status) {
            case AuthStatus.LockedOut:
              setAuthError(
                "Account is locked out. Please contact your administrator."
              );
              break;
            case AuthStatus.RequiresTwoFactor:
              if (
                apiResponse?.QrCodeUrl ||
                apiResponse?.ManualEntryKey ||
                apiResponse?.Token
              ) {
                sessionStorage.setItem(
                  "mfaData",
                  JSON.stringify({
                    QrCodeUrl: apiResponse.QrCodeUrl,
                    ManualEntryKey: apiResponse.ManualEntryKey,
                    Token: apiResponse.Token,
                    UserName: apiResponse.UserName,
                    Email: apiResponse.Email,
                    PhoneNumber: apiResponse.PhoneNumber,
                  })
                );
                sessionStorage.setItem("mfaStartTime", Date.now().toString());
              }
              navigate("/mfa-method");
              break;
            case AuthStatus.PasswordExpired:
              setAuthError("Password has expired. Please reset your password.");
              break;
            case AuthStatus.UserDisabled:
              setIsAccountDisabled(true);
              setAuthError(
                "Account disabled! If you need further assistance. Please contact (833) 832-7077, 6:00am - 12:00am, Central Time, Monday through Saturday."
              );
              break;
            case AuthStatus.EmailNotConfirmed:
              setAuthError(
                "Email not confirmed. Please check your email and confirm your account."
              );
              break;
            case AuthStatus.Failed:
            default:
              setAuthError(
                "Invalid username or password. Please try again!"
              );
              break;
          }
        } else if (apiResponse?.Token) {
          const authUser = {
            Token: apiResponse.Token,
            Authenticated: apiResponse.Authenticated,
            Status: apiResponse.Status,
            Claims: apiResponse.Claims || [],
            id: apiResponse.UserName,
            UserName: apiResponse.UserName,
            PrintName: apiResponse.PrintName || "",
            Email: apiResponse.Email,
            PhoneNumber: apiResponse.PhoneNumber,
            SessionId: apiResponse.SessionId || "",
            AuthSecretKey: apiResponse.AuthSecretKey || null,
            UserTypeId: apiResponse.UserTypeId,
            User: apiResponse.User,
          };
          justLoggedIn.current = true;
	        localStorage.setItem("lastActivityTime", Date.now().toString());
          dispatch(updateAuthUserData(authUser));
        } else {
          setIncorrectUsername(true);
        }
      } catch (error) {
        setAuthError("Login failed. Please try again.");
        console.error("Login error:", error);
      } finally {
        setLoading(false);
      }
    },
    [navigate, dispatch]
  );

  useEffect(() => {
    if (authUser?.Token && JWTValidator.isValidToken(authUser.Token)) {
      if (isVeteranPortalUser(authUser)) {
        navigate(paths.UNAUTHORIZED.pathName, {
          replace: true,
          state: { isVeteranUser: true, reason: "vp_credentials" },
        });
      } else {
        navigate(paths.HOME.pathName);
      }
    }
  }, [authUser, navigate]);
 
  useEffect(() => {
    const handleKeyDown = (e: KeyboardEvent) => {
      if (e.key === "Enter") {
        e.preventDefault();
        handleSubmit(onSubmit)();
      }
    };
 
 
 
    window.addEventListener("keydown", handleKeyDown);
    return () => window.removeEventListener("keydown", handleKeyDown);
  }, [handleSubmit, onSubmit]);
 
  const handleLogin = async () => {
  setAuthError(null);
  setSessionTimeoutMessage(null);
 
  const usernameEmpty = !getValues("username").trim();
  const passwordEmpty = !getValues("password").trim();
 
  if (usernameEmpty || passwordEmpty) {
    await trigger(["username", "password"]);
 
    if (usernameEmpty) {
      setFocus("username");
    } else {
      setFocus("password");
    }
 
    return;
  }
 
  handleSubmit(onSubmit)();
};
 
  return (
    <PublicLayout>
             <Box
  sx={{
    width: "100%",
    height: "100%",
    display: "flex",
    fontFamily: theme.typography.fontFamily,
  }}
>
      <AuthCard>
      <AuthCardHeader />
      <AuthCardBody spacing={0}>
            {sessionTimeoutMessage && (
              <AlertBanner
                message={sessionTimeoutMessage}
                sx={{ color: P.dangerText, mt:"13px" }}
              />
            )}
 
             {validationBanner && (
              <AlertBanner
                message={validationBanner}
                sx={{mt:"13px" } }
              />
            )}
 
            <Typography
              variant="inherit"
              sx={{
                fontWeight: 400,
                fontSize: "24px",
                lineHeight: "33px",
                letterSpacing: "0%",
                color: P.black,
                width: "100%",
                mt: "14px",
                mb: "20px",
                ml: "22px",
                fontFamily: theme.custom?.typeScale.openSans,
              }}
            >
              Welcome
            </Typography>
 
          <Box
            component="form"
            onSubmit={handleSubmit(onSubmit)}
            sx={{
              width: "100%",
              display: "flex",
              flexDirection: "column",
              gap: "14px",
              px: "20px",
              pb: "10px",
            }}
          >
            <Controller
              name="username"
              control={control}
              render={({ field }) => {
                const hasFieldError = !!errors.username;
                const showInlineError = hasFieldError || incorrectUsername || hasAuthError;
                const inlineErrorMessage = hasFieldError
                  ? errors.username?.message
                  : "*Incorrect username";
                return (
                  <Box sx={{ display: "flex", flexDirection: "column", width: "100%" }}>
                    <TextInput
                      {...field}
                      id="username"
                      label="Username"
                      autoComplete="new-username"
                      error={showInlineError}
                      endAdornment={
                        showInlineError ? (
                          <Box
                            component="img"
                            src={warningIcon}
                            alt="Warning"
                            sx={{
                              width: 20,
                              height: 18,
                              mr: 0.5,
                            }}
                          />
                        ) : null
                      }
                    />
                    {hasFieldError && (
                      <Typography
                        variant="caption"
                        sx={(theme) => ({
                          color: theme.custom?.colors.dangerText,
                          fontWeight: 400,
                          fontSize: "10px",
                          mt: 0.5,
                          ml: 2.5,
                          fontFamily: theme.custom?.typeScale.openSans,
                        })}
                      >
                        {inlineErrorMessage}
                      </Typography>
                    )}
                  </Box>
                );
              }}
            />
 
            <Controller
              name="password"
              control={control}
              render={({ field }) => (
                <Box sx={{ display: "flex", flexDirection: "column", width: "100%" }}>
                  <TextInput
                    {...field}
                    id="password"
                    label="Password"
                    type="password"
                    autoComplete="new-password"
                    error={!!errors.password || hasAuthError}
                    endAdornment={
                      (!!errors.password || hasAuthError) ? (
                        <Box
                            component="img"
                            src={warningIcon}
                            alt="Warning"
                            sx={{
                              width: 20,
                              height: 18,
                              mr: 0.5,
                            }}
                          />
                      ) : null
                    }
                  />
                  {errors.password && (
                    <Typography
                      variant="caption"
                      sx={(theme) => ({
                        color: theme.custom?.colors.dangerText,
                        fontWeight: 400,
                        fontSize: "10px",
                        mt: 0.5,
                        ml: 2.5,
                        fontFamily: theme.custom?.typeScale.openSans,
                      })}
                    >
                      {errors.password.message}
                    </Typography>
                  )}
                </Box>
              )}
            />
 
            <Controller
              name="termsAccepted"
              control={control}
              render={({ field }) => {
                const showError = !field.value && !!errors.termsAccepted;
                return (
                  <FormControlLabel
                    control={
                      <Checkbox
                        {...field}
                         checked={field.value}
                         disabled={noticeAccepted}
                        sx={(theme) => ({
                          mt: "-3px",
                          color: showError
                            ? theme.custom?.colors.dangerText
                            : blackColor,
                          padding: 0,
                          marginRight: "8px",
                          ml: "20px",
                          "&.Mui-checked": {
                            color: showError
                              ? theme.custom?.colors.dangerText
                              : theme.palette.primary.main,
                          },
                          "& .MuiSvgIcon-root": {
                            mt: "3px",
                            fontSize: "16px",
                           
                          },
                           "&.Mui-disabled": {
                            color: "#454545",                
                          },
                        })}
                      />
                    }
                    label={
                     <MuiLink
                        component="button"
                        type="button"
                        sx={(theme) => ({
                          color: showError
                            ? theme.custom?.colors.dangerText
                            : blackColor,
                          fontSize: "12px",
                          cursor: "pointer",
                          textDecoration: "underline",
                          textDecorationColor: showError
                            ? theme.custom?.colors.dangerText
                            : blackColor,
                          textDecorationThickness: "0.8px",
                          textUnderlineOffset: "3px",
                          mt: 0,
                          ml: 0,
                          display: "inline-flex",
                          alignItems: "center",
                          lineHeight: 1,
                          background: "none",
                          border: "none",
                          padding: 0,
                          font: "inherit",
                        })}
                        onClick={(e) => {
                          e.stopPropagation(); 
                          setShowNoticeModal(true); 
                        }}
                      >
                        Terms & Conditions
                      </MuiLink>
                    }
                    sx={{
                      margin: 0,
                      width: "100%",
                      justifyContent: "flex-start",
                      alignItems: "center",
                      "& .MuiFormControlLabel-label": {
                        display: "inline-flex",
                        alignItems: "center",
                      },
                    }}
                  />
                );
              }}
            />
 
            <Button
              type="button"
              onClick={handleLogin}
              variant="contained"
              disabled={isAccountDisabled}
              sx={{
                width: "100%",
                height: "51px",
                borderRadius: "10px",
                textTransform: "none",
                fontSize: "14px",
                fontWeight: 400,
                backgroundColor: P.primary,
                mt: "10px",
                "&:hover": {
                  backgroundColor: P.primaryHover,
                },
                "&.Mui-disabled": {
                  backgroundColor: P.wqTabInactiveText,
                  color: P.white,
                  opacity: 1,
                },
              }}
              startIcon={loading ? <CircularProgress size={20} color="inherit" /> : null}
            >
              {loading ? "Logging in..." : "Login"}
            </Button>
 
            <MuiLink
              onClick={() => navigate(paths.ForgotPassword.pathName)}
              sx={{
                color: P.black,
                cursor: "pointer",
                fontSize: "12px",
                textAlign: "center",
                mt: "2px",
                mb: 1,
                textDecoration: "underline",
                textUnderlineOffset: '2px', 
                "&:hover": {
                  textDecoration: "underline",
                  textUnderlineOffset: "2px",
                  textDecorationColor: P.black,
                  textDecorationThickness: "1px",
                },
              }}
            >
              Forgot Password?
            </MuiLink>
 
          </Box>
          </AuthCardBody>

  <AuthCardFooter />
</AuthCard>
          
      </Box>
      {toastType === "passwordCreated" && (
      <CommonToast
        title="Password Has Been Set Successfully!"
        description="Your password has been successfully created. You can now sign in to your account."
        autoClose={5000}
        onClose={() => setToastType(null)}
      />
      )}

        {toastType === "passwordReset" && (
          <CommonToast
            title="Password Has Been Reset Successfully!"
            description="Your password has been successfully reset. You can now sign in to your account."
            autoClose={5000}
            onClose={() => setToastType(null)}
          />
        )}
        {toastType === "passwordExpired" && (
          <CommonToast
            title="Password Has Been Set Successfully!"
            description="Your password has been successfully created. You can now sign in to your account."
            autoClose={5000}
            onClose={() => setToastType(null)}
          />
        )}
        {/* Notice modal — shown on first visit until the user accepts */}
      <NoticeModal
        open={showNoticeModal}
        onClose={() => setShowNoticeModal(false)}
        onAccept={() => {
          setNoticeAcceptedCookie();
          setNoticeAccepted(true);
          setValue("termsAccepted", true, { shouldValidate: true });
          setShowNoticeModal(false);
        }}
      />
    </PublicLayout>
  );
};
 
export default Login;
