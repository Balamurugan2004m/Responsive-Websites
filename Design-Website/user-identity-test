import { isVeteranPortalUser, USER_TYPE_IDS } from "./user-identity";

describe("user-identity utils", () => {
  it("returns true when UserTypeId is 4", () => {
    expect(isVeteranPortalUser({ UserTypeId: 4 })).toBe(true);
    expect(isVeteranPortalUser({ UserTypeId: USER_TYPE_IDS.VETERAN })).toBe(true);
  });

  it("returns true when nested User.UserTypeId is 4", () => {
    expect(isVeteranPortalUser({ User: { UserTypeId: 4 } })).toBe(true);
  });

  it("returns false for internal staff UserTypeIds (1, 2, 3)", () => {
    expect(isVeteranPortalUser({ UserTypeId: 1 })).toBe(false);
    expect(isVeteranPortalUser({ UserTypeId: 2 })).toBe(false);
    expect(isVeteranPortalUser({ UserTypeId: 3 })).toBe(false);
    expect(isVeteranPortalUser({ User: { UserTypeId: 1 } })).toBe(false);
  });

  it("returns false for null/undefined or empty object", () => {
    expect(isVeteranPortalUser(null)).toBe(false);
    expect(isVeteranPortalUser(undefined)).toBe(false);
    expect(isVeteranPortalUser({})).toBe(false);
  });

  it("returns true when claims contain Veteran role", () => {
    expect(
      isVeteranPortalUser({
        Claims: [
          { ClaimType: "http://schemas.microsoft.com/ws/2008/06/identity/claims/role", ClaimValue: "Veteran" },
        ],
      })
    ).toBe(true);
  });
});
