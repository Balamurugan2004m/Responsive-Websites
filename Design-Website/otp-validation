import React, { useState, useRef, useEffect } from "react";
import {
    Box,
    Button,
    Typography,
    Link as MuiLink,
    TextField,
    CircularProgress,
    useTheme,
} from "@mui/material";
import { useLocation, useNavigate } from "react-router";
import { useDispatch } from "react-redux";
import PublicLayout from "../../layouts/public-layout/public-layout";
import { verifyCode,generateCode,  insertLoginSession } from "../../services/auth";
import { OtpType } from "../../services/interfaces";
import { updateAuthUserData } from "../../store/slice/auth-slice";
import { paths } from "../../constants/paths";
import { isVeteranPortalUser } from "../../utils/user-identity";
import { THEME_PRIMITIVES } from "../../theme";
import AlertBanner from "../../ui/alert-banner";
import AuthCard, {
  AuthCardHeader,
  AuthCardBody,
  AuthCardFooter,
} from "../../components/auth/auth-card";
import { AuthStatus } from "../../constants/auth-status";

interface MfaData {
    QrCodeUrl: string | null;
    ManualEntryKey: string | null;
    Token: string;
    UserName: string;
    Email: string;
    PhoneNumber: string;
}

const OtpValidation: React.FC = () => {
    const theme = useTheme();
    const P = THEME_PRIMITIVES;
    const navigate = useNavigate();
    const dispatch = useDispatch();
    const [otp, setOtp] = useState<string[]>(Array(6).fill(""));
    const inputRefs = useRef<Array<HTMLInputElement | null>>([]);
    const [errorMessage, setErrorMessage] = useState<string | null>(null);
    const [isOtpError, setIsOtpError] = useState(false);
    const [loading, setLoading] = useState(false);
    const [mfaData, setMfaData] = useState<MfaData | null>(null);
    const location = useLocation();
    const source = location.state?.source || "email";
    const totpCodeFromAuthenticator = location.state?.totpCode || "";
    const destinationFromState = location.state?.destination || null;
    const [timeLeft, setTimeLeft] = useState(120);

    useEffect(() => {
        const storedMfaData = sessionStorage.getItem("mfaData");
        if (storedMfaData) {
            try {
                setMfaData(JSON.parse(storedMfaData));
            } catch (error) {
                console.error("Error parsing MFA data:", error);
            }
        }

        if (source === "authenticator" && totpCodeFromAuthenticator) {
            const codeArray = totpCodeFromAuthenticator.split("").slice(0, 6);
            const filledOtp = [...Array(6).fill("")];
            codeArray.forEach((digit: string, index: number) => {
                filledOtp[index] = digit;
            });
            setOtp(filledOtp);
        }
    }, [source, totpCodeFromAuthenticator]);

      useEffect(() => {
        if (timeLeft <= 0) return;

        const interval = setInterval(() => {
          setTimeLeft((prev) => prev - 1);
        }, 1000);

        return () => clearInterval(interval);
      }, [timeLeft]);

    const handleChange = (index: number, value: string) => {
        if (/^\d*$/.test(value) && value.length <= 1) {
            const newOtp = [...otp];
            newOtp[index] = value;
            setOtp(newOtp);
            setIsOtpError(false);
            setErrorMessage(null);
            if (value && index < 5) {
                inputRefs.current[index + 1]?.focus();
            }
        }
    };

    const handleKeyDown = (index: number, e: React.KeyboardEvent) => {
        if (e.key === "Backspace" && !otp[index] && index > 0) {
            inputRefs.current[index - 1]?.focus();
        }
    };

    const handlePaste = (e: React.ClipboardEvent) => {
        e.preventDefault();
        const pasteData = e.clipboardData.getData("text/plain").slice(0, 6);
        if (/^\d+$/.test(pasteData)) {
            const newOtp = [...otp];
            for (let i = 0; i < pasteData.length; i++) {
                if (i < 6) {
                    newOtp[i] = pasteData[i];
                }
            }
            setOtp(newOtp);
            setIsOtpError(false);
            setErrorMessage(null);
        }
    };

    const handleSubmit = async (e: React.FormEvent) => {
        e.preventDefault();
        const fullOtp = otp.join("");
        setErrorMessage(null);
        setIsOtpError(false);

        if (fullOtp.length < 6) {
            setErrorMessage("* Required field");
            setIsOtpError(true);
            return;
        }

        if (!mfaData) {
            setErrorMessage("* Session expired. Please login again.");
            setIsOtpError(true);
            return;
        }

        let provider: OtpType;
        let destination: string;

        switch (source) {
            case "authenticator":
                provider = OtpType.AuthenticatorApp;
                destination = mfaData.UserName;
                break;
            case "email":
                provider = OtpType.Email;
                destination = destinationFromState || mfaData.Email;
                break;
            case "sms":
                provider = OtpType.Sms;
                destination = destinationFromState || mfaData.PhoneNumber;
                break;
            default:
                provider = OtpType.Email;
                destination = destinationFromState || mfaData.Email;
        }

        setLoading(true);

        try {
            const response = await verifyCode(
                {
                    Destination: destination,
                    Provider: provider,
                    Code: fullOtp,
                },
                mfaData.Token
            );

            if (response.Status === AuthStatus.PasswordExpired) {
              const userName = response.UserName || mfaData.UserName;
      
              sessionStorage.setItem("forceSetPasswordUserName", userName);
              navigate(paths.FORCE_SET_PASSWORD.pathName, {
                state: { token: response.Token }, 
              });
              return;
            } 
            
            if (response.Authenticated === false) {
                setErrorMessage("* Invalid verification code. Please try again!");
                setIsOtpError(true);
                return;
            }

            if (response.Token && response.Authenticated === true) {
                sessionStorage.removeItem("mfaData");
                sessionStorage.removeItem("mfaStartTime");

                const authUser = {
                    Token: response.Token,
                    Authenticated: response.Authenticated,
                    Status: response.Status || 0,
                    Claims: response.Claims || [],
                    id: response.UserName || mfaData.UserName,
                    UserName: response.UserName || mfaData.UserName,
                    PrintName: response.PrintName || "",
                    Email: response.Email || mfaData.Email,
                    PhoneNumber: response.PhoneNumber || mfaData.PhoneNumber,
                    SessionId: response.SessionId || "",
                    AuthSecretKey: response.AuthSecretKey || null,
                    UserTypeId: response.UserTypeId,
                    User: response.User,
                };

                dispatch(updateAuthUserData(authUser));

                const tenantId = Number(import.meta.env.VITE_TENANT_ID) || 7143;
                const userId = 0;

                try {
                    await insertLoginSession({
                        UserName: mfaData.UserName,
                        Password: "",
                        RememberMe: false,
                        TenantId: tenantId,
                        LoginSessionId: response.SessionId ?? "",
                        LogOutMode: "A",
                        UserId: userId,
                        ExpirationTime: new Date().toISOString(),
                    });
                } catch (error) {
                    console.error("InsertLoginSession failed", error);
                }

                if (isVeteranPortalUser(authUser)) {
                    navigate(paths.UNAUTHORIZED.pathName, {
                        replace: true,
                        state: { isVeteranUser: true, reason: "vp_credentials" },
                    });
                } else {
                    navigate(paths.HOME.pathName);
                }

            } else {
                setErrorMessage("* Invalid verification code. Please try again!");
                setIsOtpError(true);
            }
        } catch (error: any) {
            const errorMessage =
                error?.response?.data?.message ||
                error?.message ||
                "Invalid verification code. Please try again!";
            setErrorMessage(`* ${errorMessage}`);
            setIsOtpError(true);
        } finally {
            setLoading(false);
        }
    };
  const handleResend = async () => {
    if (source !== "email") {
      return;
    }
    // Allow resend only after the timer reaches 0
    if (timeLeft > 0) return;
  
    if (!mfaData) {
      setErrorMessage("* Session expired. Please login again.");
      setIsOtpError(true);
      return;
    }
  
    try {
      await generateCode(
        {
          Destination:
            source === "authenticator"
              ? mfaData.UserName
              : destinationFromState || mfaData.Email,
  
          Provider:
            source === "authenticator"
              ? OtpType.AuthenticatorApp
              : OtpType.Email,
        },
        mfaData.Token
      );
  
      // Reset timer
      setTimeLeft(120);
  
      // Clear previous OTP
      setOtp(Array(6).fill(""));
  
      // Clear previous errors
      setErrorMessage(null);
      setIsOtpError(false);
  
      // Focus the first OTP box again
      inputRefs.current[0]?.focus();
    } catch (error: any) {
      const message =
        error?.response?.data?.message ||
        error?.message ||
        "Failed to resend verification code.";
  
      setErrorMessage(`* ${message}`);
      setIsOtpError(true);
        }
    };

    const handleBackToLogin = () => {
        sessionStorage.removeItem("mfaData");
        sessionStorage.removeItem("mfaStartTime");
        navigate("/login");
    };
  const maskEmail = (email: string) => {
    const [name, domain] = email.split("@");
    return `${name.substring(0, 1)}***@${domain}`;
  };
    const subtitle =
        source === "authenticator"
            ? "Enter the 6-digit code generated in the Authenticator app."
      : `Please type 6-digit verification code sent to ${maskEmail(
          destinationFromState || mfaData?.Email || ""
        )}.`;

  const minutes = Math.floor(timeLeft / 60);
  const seconds = timeLeft % 60;

  const timer = `${minutes}:${seconds.toString().padStart(2, "0")}`;

    return (
        <PublicLayout>
            <Box
  sx={{
    width: "100%",
    height: "100%",
    display: "flex",
    fontFamily: theme.typography.fontFamily,
  }}
>
        <AuthCard>
          <AuthCardHeader />
          <AuthCardBody spacing={0}>
           
                    <Box
                        component="form"
                        onSubmit={handleSubmit}
                        sx={{
                            display: "flex",
                            flexDirection: "column",
                        }}
                    >
                  {errorMessage && (
                  <AlertBanner
                    message={
                      errorMessage === "* Required field"
                        ? "Please enter the verification code."
                        : errorMessage.replace("* ", "")
                    }
                  />
                )}
                        <Typography
                            variant="inherit"
                            sx={(theme) => ({
                                fontWeight: 400,
                                fontSize: "24px",
                                // lineHeight: "normal",
                                lineHeight: "100%",
                                letterSpacing: "0%",
                                color: theme.palette.text.primary,
                                 fontFamily: theme.custom?.typeScale.openSans,
                            })}
                        >
                            Confirm
                        </Typography>

                        <Typography
                            variant="inherit"
                            component="p"
                            sx={(theme) => ({
                                fontWeight: 400,
                                fontSize: "12px !important",
                                // lineHeight: "normal",
                                lineHeight: "20px",
                                color: "#757575",
                                mb: "20px",
                                fontFamily: theme.custom?.typeScale.openSans,
                            })}
                        >
                            {subtitle}
                        </Typography>

                        <Box
                            sx={{
                                display: "flex",
                                justifyContent: "space-between",
                                gap: "15px",
                            }}
                        >
                            {otp.map((digit, index) => (
                                <TextField
                                    key={index}
                                    inputRef={(el) =>
                                        (inputRefs.current[index] = el)
                                    }
                                    value={digit}
                                    onChange={(e) =>
                                        handleChange(index, e.target.value)
                                    }
                                    onKeyDown={(e) => handleKeyDown(index, e)}
                                    onPaste={handlePaste}
                                    error={isOtpError}
                                    disabled={loading}
                                    autoComplete="off"
                                    inputProps={{
                                        maxLength: 1,
                                        inputMode: "numeric",
                                        pattern: "[0-9]*",
                                        autoComplete: "off",
                                        style: {
                                            textAlign: "center",
                                            fontSize: "20px",
                                            padding: 0,
                                            height: "45px",
                                            width: "45px",
                                            boxSizing: "border-box",
                                        },
                                    }}
                                    sx={(theme) => ({
                                        width: "45px",
                                        height: "45px",
                                        "& .MuiOutlinedInput-root": {
                                            height: "45px",
                                            width: "45px",
                                            borderRadius: "10px",
                                            padding: 0,

                        backgroundColor: digit
                          ? theme.palette.background.paper
                          : P.searchInputBgLight,

                        transition: "all 0.2s ease",

                                            "& fieldset": {
                          border: isOtpError
                            ? `0.5px solid ${theme.palette.error.main}`
                            : digit
                            ? "0.5px solid #244794"
                            : "0.5px solid #000000",
                                            },

                                            "&:hover fieldset": {
                          borderColor: theme.palette.primary.main,
                        },

                        "&.Mui-focused": {
                          backgroundColor: theme.palette.background.paper,
                          boxShadow: "0px 2px 8px rgba(37, 99, 235, 0.18)",
                                            },
                                            "&.Mui-focused fieldset": {
                          border: "0.5px solid #244794",
                        },
                      },
                      "& .MuiOutlinedInput-root.Mui-error .MuiOutlinedInput-notchedOutline": {
                        borderColor: "#700000 !important",
                      },
                      "& .MuiOutlinedInput-root.Mui-error:hover .MuiOutlinedInput-notchedOutline": {
                        borderColor: "#700000 !important",
                                            },
                      
                      "& .MuiOutlinedInput-root.Mui-focused.Mui-error .MuiOutlinedInput-notchedOutline": {
                        borderColor: "#700000 !important",
                                        },
                                    })}
                                />
                            ))}
                        </Box>

                            {errorMessage === "* Required field" && (
                            <Typography
                                variant="caption"
                                sx={{
                                  color: "#700000",
                                    fontWeight: 400,
                                    fontSize: "10px",
                                    mt: "6px",
                                }}
                                                        >
                                * Required field
                              </Typography>
                            )}
                            {source === "email" && (
                                          <Box
                                            sx={{
                                              mt: 1,
                                              display: "flex",
                                              justifyContent: "space-between",
                                              alignItems: "center",
                                            }}
                                          >
                                            <Typography
  sx={{
    fontSize: "10px !important",
  }}
>
                                              Did not receive the code?{" "}
                                              <MuiLink
                              onClick={timeLeft === 0 ? handleResend : undefined}
                              underline="always"
                              sx={{
                                fontSize: "10px !important",
                                cursor: timeLeft === 0 ? "pointer" : "not-allowed",
                                opacity: timeLeft === 0 ? 1 : 0.5,
                                pointerEvents: timeLeft === 0 ? "auto" : "none",
                              }}
                            >
                              Resend code
                            </MuiLink>
                            </Typography>
                          {/* <Typography fontSize={12}>{timer}</Typography> */}
                          {timeLeft > 0 && (
  <Typography
  sx={{
    fontSize: "10px !important",
  }}
>{timer}</Typography>
)}
                        </Box>
                        )}

                        <Button
                            type="submit"
                            variant="contained"
                            fullWidth
                            sx={(theme) => ({
                                mt: "20px",
                                height: "51px",
                                borderRadius: "10px",
                                textTransform: "none",
                                fontSize: "14px",
                                fontWeight: 400,
                                backgroundColor: theme.palette.primary.main,
                                "&:hover": {
                                    backgroundColor: theme.palette.primary.main,
                                },
                            })}
                        >
                            {loading ? (
                                <CircularProgress size={24} color="inherit" />
                            ) : (
                                "Verify code"
                            )}
                        </Button>

                        <MuiLink
                            onClick={handleBackToLogin}
                            sx={(theme) => ({
                                color: theme.palette.text.primary,
                                cursor: "pointer",
                                fontSize: "12px",
                                textAlign: "center",
                                textDecoration: "underline",
                                textUnderlineOffset: '2px',
                                textDecorationColor: theme.palette.text.primary,
                                mt: "14px",
                                "&:hover": {
                                    textDecoration: "underline",
                                },
                            })}
                        >
                            Back to login
                        </MuiLink>

                    </Box>
          </AuthCardBody>
          <AuthCardFooter />
        </AuthCard>
            </Box>
        </PublicLayout>
    );
};

export default OtpValidation;
